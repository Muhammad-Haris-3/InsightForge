DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
CORS_ORIGINS=http://localhost:3000
# Leave defaults (false / lax) for local dev. Render sets COOKIE_SECURE=true and
# COOKIE_SAMESITE=none so the session cookie survives the Vercel<->Render cross-site hop.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
